# ComfyUI Authentication Configuration
# RBAC - Basic authentication credentials
COMFYUI_AUTH_USERNAME=admin
COMFYUI_AUTH_PASSWORD=change-me

# Plugins governance - comma-separated list of allowed plugins
# Only plugins in this list will be permitted
COMFYUI_ALLOWED_PLUGINS=ComfyUI-Manager

# GPU admission - GPU access is controlled via Docker gpus: all
# Additional GPU settings can be configured here
COMFYUI_GPU_DEVICES=all
