# JupyterLab Configuration
# RBAC - Token-based authentication
JUPYTER_TOKEN=change-me-jupyterlab-token

# Enable JupyterLab (not classic notebook)
JUPYTER_ENABLE_LAB=True

# Don't open browser (container environment)
JUPYTER_NO_BROWSER=True

# Plugins governance - restrict to approved plugins only
# Add plugin names to this list to allow them
JUPYTERLAB_ALLOWED_PLUGINS=jupyterlab-git,jupyterlab-lsp,jupyterlab-code-formatter

# GPU admission - request GPU access
# Set to "all" or specific GPU indices
JUPYTERLAB_GPU_DEVICES=all

# Resource limits
# Memory limit in bytes (e.g., 2G = 2147483648)
JUPYTERLAB_MEM_LIMIT=2147483648

# Backup configuration
JUPYTERLAB_BACKUP_DIR=/backup
