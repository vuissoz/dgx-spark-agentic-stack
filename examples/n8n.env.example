# n8n Environment Configuration Example
# Use these values as root-only runtime environment input and customize as needed.
# Do not mount a directory at /home/node/.n8n/config: n8n reserves that path
# for its generated instance settings file.

# Basic Authentication
# Set to true to enable basic authentication
N8N_BASIC_AUTH_ACTIVE=true

# Basic auth username
N8N_BASIC_AUTH_USER=admin

# Basic auth password - CHANGE THIS in production!
N8N_BASIC_AUTH_PASSWORD=change-me

# Server Configuration
# The host n8n should bind to inside the container
N8N_HOST=0.0.0.0

# The port n8n should listen on inside the container
N8N_PORT=5678

# Protocol to use (http or https)
N8N_PROTOCOL=http

# Environment mode
NODE_ENV=production

# Logging Configuration
# Log level: debug, info, warn, error
N8N_LOG_LEVEL=info

# Log output: console, file, or both
N8N_LOG_OUTPUT=console

# Timezone for scheduling
N8N_TIMEZONE=UTC

# Enable instant webhooks (for testing/development)
N8N_ENABLE_INSTANT_WEBHOOK=false

# Maximum memory usage in MB
N8N_MAX_MEMORY_USAGE=1024

# Database configuration (SQLite by default)
# N8N_DATABASE_TYPE=sqlite
# N8N_DATABASE_PATH=/home/node/.n8n/database.sqlite

# For PostgreSQL (uncomment and configure if using PostgreSQL)
# N8N_DATABASE_TYPE=postgresdb
# N8N_DATABASE_HOST=postgres
# N8N_DATABASE_PORT=5432
# N8N_DATABASE_NAME=n8n
# N8N_DATABASE_USER=n8n
# N8N_DATABASE_PASSWORD=your-postgres-password

# Proxy configuration (if behind a proxy)
# HTTP_PROXY=http://egress-proxy:3128
# HTTPS_PROXY=http://egress-proxy:3128
# NO_PROXY=ollama-gate,optional-forgejo,unbound,egress-proxy,localhost,127.0.0.1
