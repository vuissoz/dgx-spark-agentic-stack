{
  "version": 1,
  "description": "Runtime secrets managed by ./agent secrets. Paths are relative to ${AGENTIC_ROOT}/secrets/runtime.",
  "non_secret_settings": [
    {"name": "COMFYUI_AUTH_USERNAME", "module": "ui", "default": "admin"},
    {"name": "N8N_BASIC_AUTH_USER", "module": "n8n", "default": "admin"}
  ],
  "secrets": [
    {
      "id": "gate-mcp-auth-token",
      "module": "core",
      "profiles": ["core"],
      "path": "gate_mcp.token",
      "required": true,
      "validation": {"type": "min_length", "value": 32},
      "prompt": "Gate MCP authentication token"
    },
    {
      "id": "openclaw-auth-token",
      "module": "core",
      "profiles": ["core"],
      "path": "openclaw.token",
      "required": true,
      "validation": {"type": "min_length", "value": 32},
      "prompt": "OpenClaw authentication token"
    },
    {
      "id": "openclaw-webhook-secret",
      "module": "core",
      "profiles": ["core"],
      "path": "openclaw.webhook_secret",
      "required": true,
      "validation": {"type": "min_length", "value": 32},
      "prompt": "OpenClaw webhook secret"
    },
    {
      "id": "comfyui-auth-password",
      "module": "comfyui",
      "profiles": ["ui", "m8"],
      "path": "comfyui.auth_password",
      "required": true,
      "validation": {"type": "password", "min_length": 16, "forbidden": ["change-me", "password", "admin"]},
      "prompt": "ComfyUI authentication password"
    },
    {
      "id": "n8n-basic-auth-password",
      "module": "n8n",
      "profiles": ["optional-n8n"],
      "activation_modules": ["n8n", "n8n-ai"],
      "path": "n8n.auth_password",
      "required": true,
      "validation": {"type": "password", "min_length": 16, "forbidden": ["change-me", "password", "admin"]},
      "prompt": "n8n Basic Auth password"
    },
    {
      "id": "n8n-sandbox-api-key",
      "module": "n8n-ai",
      "profiles": ["optional-n8n-ai"],
      "activation_modules": ["n8n-ai"],
      "path": "n8n-sandbox/api.key",
      "required": true,
      "validation": {"type": "min_length", "value": 32},
      "prompt": "n8n sandbox API key"
    },
    {
      "id": "n8n-sandbox-registration-token",
      "module": "n8n-ai",
      "profiles": ["optional-n8n-ai"],
      "activation_modules": ["n8n-ai"],
      "path": "n8n-sandbox/registration.token",
      "required": true,
      "validation": {"type": "min_length", "value": 32},
      "prompt": "n8n sandbox runner registration token"
    },
    {
      "id": "n8n-sandbox-runner-key",
      "module": "n8n-ai",
      "profiles": ["optional-n8n-ai"],
      "activation_modules": ["n8n-ai"],
      "path": "n8n-sandbox/runner.key",
      "required": true,
      "validation": {"type": "min_length", "value": 32},
      "prompt": "n8n sandbox runner API key"
    },
    {
      "id": "n8n-sandbox-searxng-key",
      "module": "n8n-ai",
      "profiles": ["optional-n8n-ai"],
      "activation_modules": ["n8n-ai"],
      "path": "n8n-sandbox/searxng.key",
      "required": true,
      "validation": {"type": "min_length", "value": 32},
      "prompt": "n8n sandbox SearXNG key"
    },
    {
      "id": "huggingface-token",
      "module": "comfyui",
      "profiles": ["ui", "m8"],
      "path": "huggingface.token",
      "required": false,
      "validation": {"type": "prefix_or_empty", "prefix": "hf_"},
      "prompt": "Hugging Face token for gated ComfyUI models"
    }
  ]
}
